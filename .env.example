# ─────────────────────────────────────────────
#  ReelSnap Backend — Environment Variables
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Flask
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=change-this-to-a-long-random-string

# Server
HOST=0.0.0.0
PORT=5000

# CORS — comma separated allowed origins
# Use * for all (not recommended in production)
ALLOWED_ORIGINS=http://localhost:3000,https://yourfrontend.vercel.app

# Rate Limiting (requests per minute per IP)
RATE_LIMIT=10
